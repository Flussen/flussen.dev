---
import AboutMeCode from "../AboutMeCode"
import Section from "../Section.astro"
import { getTranslation, type Locale } from "@/lib/i18n";

interface Props {
  cvData: any;
  locale: Locale;
}

const { cvData, locale } = Astro.props;
const { summary } = cvData.basics;
---

<Section title={getTranslation(locale, "About me")}>
  <AboutMeCode summary={summary} client:load />
</Section>
