---
import Section from "../Section.astro";
import { getTranslation, type Locale } from "@/lib/i18n";

interface Props {
  cvData: any;
  locale: Locale;
}

interface Project {
  name: string;
  isActive: boolean;
  description: string;
  highlights: string[];
  url: string | null;
  github: string | null;
}

const { cvData, locale } = Astro.props;
const projects: Project[] = cvData.projects;
---

<Section title={getTranslation(locale, "Projects")}>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map(({ name, isActive, description, highlights, url, github }) => (
      <article
        class="group relative flex flex-col rounded-lg border border-border/60
               bg-linear-to-br from-card/80 to-card/40 backdrop-blur p-5 sm:p-6
               shadow-sm transition-all duration-300 hover:shadow-md hover:border-border/80
               hover:from-card hover:to-card/60 hover:-translate-y-0.5">
        {isActive && (
          <div class="absolute -top-px -right-px">
            <div class="flex items-center gap-1.5 rounded-bl-lg rounded-tr-lg bg-emerald-500/10 px-2.5 py-1.5 ring-1 ring-emerald-500/20">
              <span class="flex h-2 w-2 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Active</span>
            </div>
          </div>
        )}

        <header class="flex items-start justify-between gap-3 mb-2">
          <div class="flex-1 min-w-0">
            <h3 class="font-semibold text-base sm:text-lg text-foreground leading-tight break-words group-hover:text-primary transition-colors">
              {name}
            </h3>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            {github && (
              <a
                href={github}
                target="_blank"
                rel="noreferrer"
                aria-label="GitHub repository"
                class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-all hover:scale-110">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            )}
            {url && (
              <a
                href={url}
                target="_blank"
                rel="noreferrer"
                aria-label="Live project"
                class="rounded-md p-1.5 text-muted-foreground hover:text-foreground hover:bg-muted/80 transition-all hover:scale-110">
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                  />
                </svg>
              </a>
            )}
          </div>
        </header>

        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed flex-1 line-clamp-4 sm:line-clamp-3">
          {description}
        </p>

        {highlights && highlights.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {highlights.slice(0, 5).map((tag) => (
              <span
                class="inline-flex items-center rounded-md border border-border/50 bg-muted/50
                       px-2 py-0.5 text-xs font-medium text-muted-foreground/90
                       transition-colors hover:bg-muted/80 hover:border-border/80">
                {tag}
              </span>
            ))}
            {highlights.length > 5 && (
              <span class="inline-flex items-center rounded-md bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                +{highlights.length - 5}
              </span>
            )}
          </div>
        )}

        <!-- Decorative corner accent -->
        <div class="absolute -bottom-px -left-px h-12 w-12 rounded-tl-lg rounded-br-lg bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
      </article>
    ))}
  </div>
</Section>
