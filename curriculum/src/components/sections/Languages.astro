---
import Section from "../Section.astro";
import { getTranslation, type Locale } from "@/lib/i18n";

interface Props {
  cvData: any;
  locale: Locale;
}

interface Language {
  language: string;
  fluency: string | null;
}

const { cvData, locale } = Astro.props;
const languages: Language[] = cvData.languages;

const languageCodes: Record<string, string> = {
  "Spanish": "ES",
  "Español": "ES",
  "German": "DE",
  "Deutsch": "DE",
  "Alemán": "DE",
  "English": "EN",
  "Inglés": "EN"
};

const getFluencyColor = (fluency: string | null) => {
  if (!fluency) return "text-muted-foreground";
  if (fluency.includes("Native") || fluency.includes("Nativo") || fluency.includes("Muttersprache")) return "text-emerald-500 dark:text-emerald-400";
  if (fluency.includes("Fluent") || fluency.includes("Professional") || fluency.includes("Profesional") || fluency.includes("Berufliche")) return "text-blue-500 dark:text-blue-400";
  if (fluency.includes("Intermediate") || fluency.includes("Intermedio") || fluency.includes("Mittelstufe")) return "text-amber-500 dark:text-amber-400";
  return "text-muted-foreground";
};
---

<Section title={getTranslation(locale, "Languages")}>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {languages.map(({ language, fluency }) => (
      <article
        class="group relative flex items-center gap-4 rounded-lg border border-border/60
               bg-linear-to-br from-card/80 to-card/40 backdrop-blur p-4
               shadow-sm transition-all duration-300 hover:shadow-md hover:border-border/80
               hover:from-card hover:to-card/60">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full
                    bg-primary/10 text-xs font-bold text-primary ring-2 ring-primary/20
                    transition-transform group-hover:scale-110">
          <!-- Language icon SVG -->
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
          </svg>
        </div>
        <div class="flex flex-col gap-0.5 min-w-0 flex-1 overflow-hidden">
          <div class="flex items-center gap-2 w-full">
            <h3 class="font-semibold text-sm sm:text-base text-foreground leading-tight truncate flex-1">
              {language}
            </h3>
            <span class="font-mono text-[10px] sm:text-xs font-bold text-muted-foreground/60 shrink-0">
              {languageCodes[language] || language.slice(0, 2).toUpperCase()}
            </span>
          </div>
          {fluency ? (
            <p class={`text-xs sm:text-sm font-medium leading-tight break-words ${getFluencyColor(fluency)}`}>
              {fluency}
            </p>
          ) : (
            <p class="text-xs sm:text-sm text-muted-foreground leading-tight">
              Learning
            </p>
          )}
        </div>
      </article>
    ))}
  </div>
</Section>
