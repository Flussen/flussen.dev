---
import Section from "../Section.astro";
import { getTranslation, type Locale } from "@/lib/i18n";

interface Props {
  cvData: any;
  locale: Locale;
}

interface Education {
  institution: string;
  url: string | null;
  area: string;
  studyType: string;
  startDate: string;
  endDate: string | null;
  courses: string[];
  score: number
}

const { cvData, locale } = Astro.props;
const education: Education[] = cvData.education;

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString("en-US", { month: "short", year: "numeric" });
}
---

<Section title={getTranslation(locale, "Education")}>
  <div class="relative space-y-6">
    <!-- Timeline vertical line -->
    <div class="absolute left-4 top-0 bottom-0 w-0.5 bg-linear-to-b from-primary/40 via-primary/20 to-transparent hidden sm:block" />

    {education.map(({ institution, url, area, studyType, startDate, endDate, courses, score }) => (
      <article class="relative">
        <div class="absolute left-0 top-6 hidden sm:flex h-8 w-8 items-center justify-center">
          <div class="h-8 w-8 rounded-full border-2 border-primary bg-background shadow-lg shadow-primary/20 flex items-center justify-center">
            <svg class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
          </div>
          {!endDate && (
            <span class="absolute h-8 w-8 rounded-full bg-primary/30 animate-ping" />
          )}
        </div>

        <div class="sm:ml-16 group relative rounded-lg border border-border/60
                    bg-linear-to-br from-card/80 to-card/40 backdrop-blur p-4 sm:p-6
                    shadow-sm transition-all duration-300 hover:shadow-md hover:border-border/80
                    hover:from-card hover:to-card/60">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="space-y-2 flex-1 min-w-0">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2">
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-lg text-foreground leading-tight break-words">
                    {area}
                  </h3>
                  <p class="mt-0.5 text-[10px] sm:text-xs font-medium text-primary/80">
                    {studyType} - {score}
                  </p>
                  {url ? (
                    <a
                      href={url}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-1.5 mt-1.5 text-sm font-medium text-muted-foreground hover:text-foreground transition-colors">
                      {institution}
                      <svg
                        class="h-3.5 w-3.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  ) : (
                    <p class="mt-1.5 text-sm font-medium text-muted-foreground">{institution}</p>
                  )}
                </div>
                {!endDate && (
                  <span class="inline-flex self-start items-center gap-1.5 rounded-full bg-blue-500/10 px-2 py-0.5 sm:px-2.5 sm:py-1 text-[10px] sm:text-xs font-medium text-blue-600 dark:text-blue-400 ring-1 ring-blue-500/20 whitespace-nowrap">
                    <span class="h-1 w-1 sm:h-1.5 sm:w-1.5 rounded-full bg-blue-500 animate-pulse" />
                    In Progress
                  </span>
                )}
              </div>
            </div>
            <time class="text-[10px] sm:text-xs font-mono text-muted-foreground/80 whitespace-nowrap shrink-0 pt-2 sm:pt-0 border-t sm:border-0 border-border/40 text-left sm:text-right">
              {formatDate(startDate)} — {endDate ? formatDate(endDate) : "Present"}
            </time>
          </div>

          {courses && courses.length > 0 && (
            <div class="mt-4">
              <h4 class="text-xs font-semibold text-muted-foreground/80 mb-2.5 uppercase tracking-wider">
                Relevant Courses
              </h4>
              <div class="flex flex-wrap gap-2">
                {courses.map((course) => (
                  <span
                    class="inline-flex items-center gap-1.5 rounded-md border border-border/50 bg-muted/50
                           px-2.5 py-1 text-xs font-medium text-muted-foreground/90
                           transition-colors hover:bg-muted/80 hover:border-border/80">
                    <svg class="h-3 w-3 text-primary/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {course}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</Section>
