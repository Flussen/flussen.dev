---
import { ProfileCard } from "@/components/ui/ProfileCard";
import Section from "../Section.astro";
import type { Locale } from "@/lib/i18n";

interface Props {
  cvData: any;
  locale: Locale;
}

const { cvData, locale } = Astro.props;
const basics = cvData.basics;
---

<Section>
    <ProfileCard basics={basics} flags={[
        { src: "/AT.svg", alt: "Austria Flag" },
        { src: "/VE.svg", alt: "Venezuela Flag" }
    ]}/>
</Section>

