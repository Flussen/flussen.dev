---
// src/components/SkillsBadges.astro

import GolangIcon from "../icons/golang.astro";
import JavaIcon from "../icons/java.astro";
import PostgresIcon from "../icons/postgresql.astro";
import GitIcon from "../icons/git.astro";
import GitHubIcon from "../icons/GitHub.astro";
import LinuxIcon from "../icons/linux.astro";
import DockerIcon from "../icons/docker.astro";
import Section from "../Section.astro";

import info from "@cv";

type Skill = {
  name: string;
  Icon: any;
};

const skills: Skill[] = [
  { name: "Golang", Icon: GolangIcon },
  { name: "Java", Icon: JavaIcon },
  { name: "PostgreSQL", Icon: PostgresIcon },
  { name: "Git", Icon: GitIcon },
  { name: "GitHub", Icon: GitHubIcon },
  { name: "Linux", Icon: LinuxIcon },
  { name: "Docker", Icon: DockerIcon },
];
---

<Section title="Skills">
  <div class="flex flex-wrap gap-2">
    {skills.map(({ name, Icon }) => (
      <div
        class="inline-flex items-center rounded-md border border-border/60
                bg-card/60 backdrop-blur  px-3 py-1 text-sm font-medium text-foreground/90
               shadow-sm">
        <span
          class="flex h-6 w-6 items-center justify-center mr-0.5">
          <Icon />
        </span>
        <span>{name}</span>
      </div>
    ))}
  </div>
</Section>

